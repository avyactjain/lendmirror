# Flip this one value. Everything else is chosen from config/devnet.ts or config/mainnet.ts.
DEPLOYMENT_TYPE=devnet

# Devnet keys and RPCs (used when DEPLOYMENT_TYPE=devnet)
SOLANA_KEYPAIR_PATH_DEVNET=
EVM_PRIVATE_KEY_DEVNET=
RPC_URL_SOLANA_DEVNET=
RPC_URL_EVM_DEVNET=

# Mainnet keys and RPCs (used when DEPLOYMENT_TYPE=mainnet)
SOLANA_KEYPAIR_PATH_MAINNET=
EVM_PRIVATE_KEY_MAINNET=
RPC_URL_SOLANA_MAINNET=
RPC_URL_EVM_MAINNET=

# Optional. Unused by Hardhat / npx lm. Left here for other tools only.
MNEMONIC=

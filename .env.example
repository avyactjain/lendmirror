#   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-
#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'
#
#               Example environment configuration
#
#   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-
#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'

# By default, the examples support both mnemonic-based and private key-based authentication
# 
# You don't need both. Use PRIVATE_KEY for the Ethereum/Sepolia wallet.
MNEMONIC=
PRIVATE_KEY=
# You don't need both Solana fields. Path is enough if the key file already exists.
# Default if both empty: ~/.config/solana/id.json
# LayerZero names RPC_URL_SOLANA_TESTNET "testnet". For us that is Solana Devnet (eid 40168).
SOLANA_PRIVATE_KEY=
SOLANA_KEYPAIR_PATH=
RPC_URL_SOLANA=
RPC_URL_SOLANA_TESTNET=
# Optional. Public Sepolia RPC is the fallback in hardhat.config.ts
RPC_URL_SEPOLIA=